<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Доставка заказов</title>
</head>
<body>
    <header>
        <strong>Доставка заказов</strong>
        @if (User.Identity?.IsAuthenticated == true)
        {
            if (User.IsInRole("Customer"))
            {
                <a asp-controller="Customer" asp-action="Index">Мои заказы</a>
            }
            if (User.IsInRole("Courier"))
            {
                <a asp-controller="Courier" asp-action="Index">Кабинет курьера</a>
            }
            if (User.IsInRole("Support") || User.IsInRole("Admin"))
            {
                <a asp-controller="Support" asp-action="Index">Поддержка</a>
            }
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                <button type="submit">Выйти (@User.Identity.Name)</button>
            </form>
        }
    </header>
    <hr />
    <main>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>