@model List<DeliveryService.Domain.Models.Order>
@{
    ViewData["Title"] = "Мои заказы";
}

<h2>Мои заказы</h2>

@if (TempData["Message"] is string msg)
{
    <p style="color:green">@msg</p>
}

<h3>API-доступ</h3>
<form asp-action="IssueKey" method="post"
      onsubmit="return @(ViewBag.KeyIssued == true ? "confirm('Старый ключ перестанет работать. Перевыпустить?')" : "true");">
    <button type="submit">@(ViewBag.KeyIssued == true ? "Перевыпустить ключ" : "Выпустить ключ")</button>
    @if (ViewBag.KeyIssued == true)
    {
        <span>Ключ выпущен</span>
    }
</form>
<hr />

<p><a asp-action="Create">Создать заказ</a></p>

@if (Model.Count == 0)
{
    <p>Заказов пока нет.</p>
}
else
{
    <table border="1" cellpadding="4">
        <tr>
            <th>Внешний номер</th>
            <th>Код</th>
            <th>Статус</th>
            <th>Получатель</th>
            <th>Адрес доставки</th>
            <th>Вес, кг</th>
            <th>Объём, м³</th>
            <th>Создан</th>
            <th>Отменить</th>
        </tr>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.ExternalNumber</td>
                <td>@o.PublicCode</td>
                <td>
                    @(o.Status.ToString() switch
                    {
                        "Created" => "Оформлен",
                        "InDelivery" => "В доставке",
                        "Delivered" => "Доставлен",
                        "Cancelled" => "Отменён",
                        _ => o.Status.ToString()
                    })
                </td>
                <td>@o.RecipientsLastName @o.RecipientsFirstName</td>
                <td>@o.DeliveryAddress</td>
                <td>@o.OrderTotalWeight.ToString("0.##")</td>
                <td>@o.OrderTotalVolume.ToString("0.####")</td>
                <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    @if (o.Status == DeliveryService.Domain.Models.Statuses.OrderStatus.Created)
                    {
                        <form asp-action="Cancel" asp-route-id="@o.Id" method="post"
                              onsubmit="return confirm('Отменить заказ @o.ExternalNumber?');">
                            <button type="submit">Отменить</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </table>
}